{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "niva-web-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "285fd6ea-0508-4017-9a16-0e9ebc2fdd4f","database_name": "niva-web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "a4e4475d25b2443197dc9ad4da2ba7c6" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
